# Скопируйте в .env и задайте свои значения. Файл .env в git не коммитится.
# Секрет: минимум 64 символа, например: openssl rand -hex 64
JwtConfiguration__SecretKey=CHANGE_ME
JwtConfiguration__Issuer=warehouse
JwtConfiguration__Audience=warehouse
JwtConfiguration__ExpirationInMinutes=30
JwtConfiguration__RefreshTokenExpirationInDays=7
